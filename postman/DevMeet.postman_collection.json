{
  "info": {
    "name": "DevMeet API",
    "description": "RESTful service for managing development team meetings",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "meetingId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Get all teams",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns teams array', () => pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/teams"
      }
    },
    {
      "name": "2. Get meetings by team",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('All meetings belong to team 1', () => pm.response.json().forEach(m => pm.expect(m.team_id).to.eql(1)));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/meetings/by-team/1"
      }
    },
    {
      "name": "3. Get meeting by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns meeting 1', () => pm.expect(pm.response.json().meeting_id).to.eql(1));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/meetings/1"
      }
    },
    {
      "name": "4. Add meeting",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('meetingId', pm.response.json().meeting_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"team_id\": 1,\n  \"start_time\": \"2027-01-15T10:00\",\n  \"end_time\": \"2027-01-15T11:30\",\n  \"description\": \"Postman test meeting\",\n  \"room\": \"Blue Room\"\n}"
        },
        "url": "{{baseUrl}}/meetings"
      }
    },
    {
      "name": "5. Update meeting",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Room updated', () => pm.expect(pm.response.json().room).to.eql('New York Room'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"team_id\": 1,\n  \"start_time\": \"2027-01-15T12:00\",\n  \"end_time\": \"2027-01-15T13:00\",\n  \"description\": \"Postman test meeting (updated)\",\n  \"room\": \"New York Room\"\n}"
        },
        "url": "{{baseUrl}}/meetings/{{meetingId}}"
      }
    },
    {
      "name": "6. Delete meeting",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/meetings/{{meetingId}}"
      }
    },
    {
      "name": "Validation errors",
      "item": [
        {
          "name": "Add - missing fields (400)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"team_id\": 1\n}" },
            "url": "{{baseUrl}}/meetings"
          }
        },
        {
          "name": "Add - start in the past (400)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"team_id\": 1,\n  \"start_time\": \"2025-01-01T10:00\",\n  \"end_time\": \"2025-01-01T11:00\",\n  \"description\": \"Past meeting\",\n  \"room\": \"Blue Room\"\n}" },
            "url": "{{baseUrl}}/meetings"
          }
        },
        {
          "name": "Add - end before start (400)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"team_id\": 1,\n  \"start_time\": \"2027-01-15T11:00\",\n  \"end_time\": \"2027-01-15T10:00\",\n  \"description\": \"Wrong times\",\n  \"room\": \"Blue Room\"\n}" },
            "url": "{{baseUrl}}/meetings"
          }
        },
        {
          "name": "Get - meeting not found (404)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"] } }],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/meetings/999999"
          }
        }
      ]
    }
  ]
}
